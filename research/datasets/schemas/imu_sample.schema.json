{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stride-strength.local/schemas/imu_sample.json",
  "title": "IMU Sample",
  "description": "Canonical per-sample inertial sensor observation shared by Python research and Kotlin SDK.",
  "type": "object",
  "required": ["dataset_id", "participant_id", "timestamp_ns", "sensor_location"],
  "properties": {
    "dataset_id": { "type": "string" },
    "participant_id": { "type": "string" },
    "session_id": { "type": "string" },
    "condition": { "type": "object", "description": "Speed, surface, fatigue state, placement/orientation, etc." },
    "timestamp_ns": { "type": "integer", "description": "Native sensor clock timestamp in nanoseconds. Non-uniform sampling assumed." },
    "delta_time_s": { "type": "number", "description": "Recorded inter-sample interval in seconds, if available." },
    "sensor_location": {
      "type": "string",
      "enum": ["pelvis", "thigh", "shank", "foot", "lumbar", "smartphone_back", "smartphone_thigh", "other"]
    },
    "ax": { "type": "number", "description": "Linear acceleration X (m/s^2)." },
    "ay": { "type": "number", "description": "Linear acceleration Y (m/s^2)." },
    "az": { "type": "number", "description": "Linear acceleration Z (m/s^2)." },
    "gx": { "type": "number", "description": "Angular velocity X (rad/s or deg/s; unit recorded in units_convention)." },
    "gy": { "type": "number", "description": "Angular velocity Y." },
    "gz": { "type": "number", "description": "Angular velocity Z." },
    "mx": { "type": "number", "description": "Magnetic field X (uT), optional." },
    "my": { "type": "number", "description": "Magnetic field Y (uT), optional." },
    "mz": { "type": "number", "description": "Magnetic field Z (uT), optional." },
    "derived_magnitude_acc": { "type": "number" },
    "derived_magnitude_gyro": { "type": "number" },
    "sampling_rate_hz": { "type": ["number", "null"] },
    "units_convention": { "type": "string", "description": "Axis orientation and unit convention description." }
  },
  "additionalProperties": false
}
